# 密钥模板：本地部署时复制为 .streamlit/secrets.toml 再填真实值
#   Windows PowerShell: Copy-Item .streamlit\secrets.toml.example .streamlit\secrets.toml
# 注意 secrets.toml 已被 .gitignore 排除，不会提交到 GitHub
#
# 云端（Streamlit Cloud）不用这个文件，改成在网页上配置：
#   App settings -> Secrets -> 粘贴下面同样格式的内容 -> Save

# ---- 必填：DeepSeek API 密钥（与本地 .env 里的值相同）----
DEEPSEEK_API_KEY = "sk-在这里填你的真实密钥"

# ---- 必填：DeepSeek 的 OpenAI 兼容接口地址 ----
OPENAI_API_BASE_URL = "https://api.deepseek.com"

# ---- 公网部署必填：访问口令 ----
# 不填 = 不加门禁，任何人打开链接都能提问并消耗你的 DeepSeek 额度
# 本地开发建议留空（删掉这一行即可），免得每次调试都要输口令
APP_PASSWORD = "自己设一个口令，别用 123456"
